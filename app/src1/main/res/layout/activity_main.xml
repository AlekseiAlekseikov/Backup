<?xml version="1.0" encoding="utf-8"?>
<!--
    Новый интерфейс: нативный каркас ui/cx (порт макета
    «Geely EX2 ГУ — концепт в стиле Zeekr» на View).
    Логика подключается через ui/UiBridge.kt (CxEventSink / CxStateSource).

    WebView здесь быть не может в принципе: приложение работает под uid 1000
    (sharedUserId="android.uid.system"), а WebViewFactory (AOSP 9, 231-236)
    безусловно запрещает WebView в привилегированных процессах.

    Каркас добавляется в контейнер cxRoot из MainActivity (cx.root), а не
    инфлейтится здесь, потому что собирается программно.

    Projection-оверлеи (Stage CPv2): TextureView поверх каркаса. CarPlay /
    Android Auto рендерятся OEM-стеком в нашу SurfaceTexture (capy-архитектура);
    каркас не может показать Surface. Оверлей раскладывается ровно по
    прямоугольнику, который измерил каркас (CxShell.projectionFramePx), и скрыт,
    пока projection-вкладка не активна. Касания оверлей перехватывает сам и
    пересылает телефону через ProjectionTouchController — каркас их не видит.

    ВАЖНО: id carplaySurface и aautoSurface менять нельзя — их читает
    ProjectionRenderBridge через activity.findViewById в своём конструкторе.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Контейнер нативного каркаса: MainActivity кладёт сюда cx.root.
         Координаты projection-оверлеев отсчитываются от этого FrameLayout,
         поэтому он обязан занимать всё окно без смещений и полей. -->
    <FrameLayout
        android:id="@+id/cxRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextureView
        android:id="@+id/carplaySurface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:clickable="true" />

    <TextureView
        android:id="@+id/aautoSurface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:clickable="true" />
</FrameLayout>
