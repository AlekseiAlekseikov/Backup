<?xml version="1.0" encoding="utf-8"?>
<!--
  Атрибуты темы. Сгенерировано из дизайн-токенов CSS-шелла
  (assets/ui/index.html, блок <style>): 14 базовых переменных,
  определенных в :root и переопределенных в body[data-th="0..8"],
  плюс три цвета палитры раздела «Инструменты».

  Алиасы cx-* отдельными атрибутами не представлены — это те же
  базовые токены; соответствие:

  (имена CSS-переменных приведены без префикса из двух дефисов —
   внутри XML-комментария такая последовательность запрещена)

    cx-window                -> ?attr/cxCard
    cx-surface               -> ?attr/cxCard
    cx-surface-soft          -> ?attr/cxCard
    cx-surface-inset         -> ?attr/cxCard2
    cx-sidebar               -> ?attr/cxCard
    cx-divider               -> ?attr/cxLine
    cx-border                -> ?attr/cxLine
    cx-text                  -> ?attr/cxInk
    cx-text-secondary        -> ?attr/cxMuted
    cx-text-muted            -> ?attr/cxMuted2
    cx-green-soft            -> ?attr/cxCard2
    cx-sel-bg                -> ?attr/cxSel
    cx-sel-fg                -> ?attr/cxOnSel
    cx-control               -> ?attr/cxTrack
    cx-off                   -> ?attr/cxTrack
    cx-android-blue          -> ?attr/cxAccent

-->
<resources>
    <!-- CSS: page1 — фон страницы, верх градиента -->
    <attr name="cxPage1" format="color" />
    <!-- CSS: page2 — фон страницы, низ градиента -->
    <attr name="cxPage2" format="color" />
    <!-- CSS: card — карточка, поверхность -->
    <attr name="cxCard" format="color" />
    <!-- CSS: card2 — вложенная поверхность, inset -->
    <attr name="cxCard2" format="color" />
    <!-- CSS: ink — основной текст -->
    <attr name="cxInk" format="color" />
    <!-- CSS: muted — вторичный текст -->
    <attr name="cxMuted" format="color" />
    <!-- CSS: muted2 — приглушённый текст -->
    <attr name="cxMuted2" format="color" />
    <!-- CSS: line — разделитель и обводка -->
    <attr name="cxLine" format="color" />
    <!-- CSS: track — трек переключателя, неактивный элемент -->
    <attr name="cxTrack" format="color" />
    <!-- CSS: btn — основная кнопка, фон -->
    <attr name="cxBtn" format="color" />
    <!-- CSS: onbtn — основная кнопка, текст -->
    <attr name="cxOnBtn" format="color" />
    <!-- CSS: sel — выбранный элемент, фон -->
    <attr name="cxSel" format="color" />
    <!-- CSS: onsel — выбранный элемент, текст -->
    <attr name="cxOnSel" format="color" />
    <!-- CSS: barbg — плавающий док, панель -->
    <attr name="cxBarBg" format="color" />
    <!-- успех, активное состояние -->
    <attr name="cxGreen" format="color" />
    <!-- ошибка, опасное действие -->
    <attr name="cxDanger" format="color" />
    <!-- акцент, ссылка, выделение -->
    <attr name="cxAccent" format="color" />
</resources>
