<?xml version="1.0" encoding="utf-8"?>
<!--
    Нативная верхняя строка (ui/TopBarPanel.kt): заголовок авто, температура,
    часы и статус подключения. Высота совпадает с HTML-spacer .topbar (50 dp).
    Скрывается на вкладках CarPlay / Android Auto (как прежний body.projfull).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/topBar"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:layout_gravity="top" />
