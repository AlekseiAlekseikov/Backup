<?xml version="1.0" encoding="utf-8"?>
<!--
    Нативная вкладка «Сервис» (этап 7, каркас с заглушкой).
    Строит и красит ui/ServicePanel.kt. Показания автомобиля не подключены:
    в проекте нет источника данных. Панель накрывает #content (content.frame).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/servicePanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/serviceContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/serviceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сервис"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/serviceSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Состояние автомобиля"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/serviceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/serviceCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="В разработке"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/serviceCardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Пробег, давление в шинах, ТО и напряжение 12V пока не подключены: в проекте нет источника данных автомобиля."
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
