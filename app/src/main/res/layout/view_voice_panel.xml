<?xml version="1.0" encoding="utf-8"?>
<!--
    Нативная вкладка «Голос» (замена HTML-панели voice в index.html).

    Статика — здесь: заголовок, подписи, кнопки, переключатель, заголовок списка.
    Состояние микрофона, эквалайзер, карточка ответа и каталог команд ведёт
    ui/VoicePanel.kt. Панель накрывает прямоугольник #content (quick.frame-
    механизм content.frame) и скрыта на остальных вкладках.
    Размеры — как у CSS: .voiceHero, .micBtn 84, .row, .btn, .cmdSec.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voicePanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/voiceContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/voiceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Голос"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voiceSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:text="Голосовой помощник"
            android:textSize="13sp" />

        <!-- .voiceHero: микрофон с кольцами, статус, фраза активации, эквалайзер, ответ -->
        <LinearLayout
            android:id="@+id/voiceHero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <View
                    android:id="@+id/voiceRing1"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/bg_voice_ring" />

                <View
                    android:id="@+id/voiceRing2"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:background="@drawable/bg_voice_ring" />

                <TextView
                    android:id="@+id/voiceMic"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:gravity="center"
                    android:text="🎙"
                    android:textSize="34sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/voiceState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Жду обращения"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/voiceWake"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:text="«Привет, Geely»"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/voiceEq"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginTop="4dp"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/voiceEq1"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_voice_eq_bar" />

                <View
                    android:id="@+id/voiceEq2"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_voice_eq_bar" />

                <View
                    android:id="@+id/voiceEq3"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_voice_eq_bar" />

                <View
                    android:id="@+id/voiceEq4"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_voice_eq_bar" />

                <View
                    android:id="@+id/voiceEq5"
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_voice_eq_bar" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/voiceResp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/voiceRespTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voiceRespReply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Активация голосом: переключатель (тост, как в HTML) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/voiceRowTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Активация голосом"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voiceRowSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Скажите «Привет, Geely» или нажмите кнопку на руле"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/voiceSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:checked="true"
                android:showText="false" />
        </LinearLayout>

        <View
            android:id="@+id/voiceRowDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/voiceCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="Вызвать ассистента"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voiceRestart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="Перезапустить микрофон"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/voiceSectCatalog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="8dp"
            android:text="Список команд · 11 разделов"
            android:textAllCaps="true"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <LinearLayout
            android:id="@+id/voiceCatalog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
