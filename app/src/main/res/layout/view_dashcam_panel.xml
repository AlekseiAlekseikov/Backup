<?xml version="1.0" encoding="utf-8"?>
<!--
    Нативная вкладка «Видеорегистратор» (этап 6, каркас с заглушкой).
    Строит и красит ui/DashcamPanel.kt. Запись и список записей не подключены:
    в проекте нет источника видео. Панель накрывает #content (content.frame).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashcamPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/dashcamContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/dashcamTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Видеорегистратор"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dashcamSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Запись и архив поездок"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/dashcamCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/dashcamCardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="В разработке"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dashcamCardText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Запись с камеры, архив поездок и снимки пока не подключены: в проекте нет источника видео."
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
