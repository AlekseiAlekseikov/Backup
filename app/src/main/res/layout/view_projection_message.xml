<?xml version="1.0" encoding="utf-8"?>
<!--
    Нативное сообщение над областью видео CarPlay / Android Auto (этап 9,
    ui/ProjectionMessagePanel.kt). Стоит над TextureView и скрыто, пока рендер
    идёт; геометрия — по projectionFrame (та же рамка, что у видео).
    Касания не перехватывает: у FrameLayout без обработчиков их нет.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/projectionMessage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0E12"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/projectionMessageIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/projectionMessageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#FFE8EBEF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/projectionMessageSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:maxWidth="420dp"
            android:textColor="#FF7B8390"
            android:textSize="12.5sp" />
    </LinearLayout>
</FrameLayout>
