<?xml version="1.0" encoding="utf-8"?>
<!--
    Нативная вкладка «Быстрый доступ» (замена HTML-панели quick в index.html).

    Статическая часть — здесь: заголовок, подзаголовок и подписи секций.
    Кнопки создаёт ui/QuickPanel.kt (состояние выбора, цвета темы, иконки).
    Панель накрывает прямоугольник #content, который измерил JS
    (quick.frame), и скрыта на остальных вкладках. Размеры — как у CSS:
    .contentCard (padding 18/20), h2 22, .csub 13, .sect 11.5 (caps).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/quickContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/quickTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Быстрый доступ"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quickSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:text="Режим движения и телефон"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/quickSectMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="8dp"
            android:textAllCaps="true"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:text="Режим движения" />

        <LinearLayout
            android:id="@+id/quickModes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/quickSectRecup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="8dp"
            android:textAllCaps="true"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:text="Рекуперация" />

        <LinearLayout
            android:id="@+id/quickRecup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/quickSectAir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="8dp"
            android:textAllCaps="true"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:text="Направление обдува" />

        <LinearLayout
            android:id="@+id/quickAir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/quickSectHeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="8dp"
            android:textAllCaps="true"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:text="Обогрев" />

        <LinearLayout
            android:id="@+id/quickHeat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
