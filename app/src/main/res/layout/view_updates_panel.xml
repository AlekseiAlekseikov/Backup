<?xml version="1.0" encoding="utf-8"?>
<!--
    Нативная вкладка «Обновления» (этап 8, ui/UpdatesPanel.kt).
    Статика — заголовок и подпись; карточка версии, зона действий и прогресс
    строит UpdatesPanel. Проверка и установка — AppUpdater через UiBridge.
    Панель накрывает #content (content.frame).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/updatesPanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"
    android:clipToPadding="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/updatesContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <TextView
            android:id="@+id/updatesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Обновления"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updatesSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="ПО автомобиля"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/updatesBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
