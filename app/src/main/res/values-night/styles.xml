<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoiceApp" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/bar</item>
        <item name="android:navigationBarColor">@color/bar</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorPrimary">@color/bar</item>
        <item name="android:colorPrimaryDark">@color/bar</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bar</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlActivated">@color/accent</item>
    </style>

    <!-- Flutter-приложение телеметрии (порт capy LaunchTheme/NormalTheme) -->
    <style name="TelemetryLaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/telemetry_launch_background</item>
    </style>
    <style name="TelemetryNormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
